# Cabeçalhos de segurança aplicados pelo Cloudflare Pages a todas as páginas.
# connect-src: o formulário só pode conversar com a API de produção (se o endereço da API mudar, atualize aqui e no app.js).
# style-src 'unsafe-inline': necessário porque o HTML gerado pelo app.js usa atributos style="...".
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://faust-diagnostico-api.fly.dev; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
